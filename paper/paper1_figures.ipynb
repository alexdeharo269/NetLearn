def brain(ax, inter, intra):
    ax.set_xlim(-1.12, 1.12); ax.set_ylim(-1.12, 1.12); ax.set_aspect("equal"); ax.axis("off")
    for x0 in (-0.54, 0.54):
        ax.add_patch(Ellipse((x0, 0), 1.0, 2.1, facecolor="#f4f4f4", edgecolor="#9e9e9e", lw=0.6, zorder=1))
    for p, q, rad, w, c in (((-0.5, 0.42), (0.5, 0.42), -0.4, inter, HOM), ((-0.75, 0.0), (-0.45, -0.72), 0.35, intra, INTRA)):
        ax.add_patch(FancyArrowPatch(p, q, connectionstyle=f"arc3,rad={rad}", arrowstyle="-", lw=0.4 + 9 * w, color=c, capstyle="round",
                                     zorder=3, shrinkA=0, shrinkB=0))
        for xy in (p, q):
            node(ax, xy, s=7)

