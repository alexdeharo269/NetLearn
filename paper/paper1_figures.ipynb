def node(ax, xy, s=20):
    ax.scatter(*xy, s=s, color="white", edgecolor=INK, lw=0.7, zorder=4)

def walk_icon(ax, odd):
    ax.set_xlim(-0.18, 1.33); ax.set_ylim(-0.15, 1.0); ax.set_aspect("equal"); ax.axis("off")
    c = TRI if odd else DISP
    if odd:                                   # a closed walk of odd length must go round a triangle (or another odd cycle)
        P = [(0.05, 0.05), (1.0, 0.05), (0.525, 0.85)]
        for u, v in ((0, 1), (1, 2), (2, 0)):
            ax.plot(*zip(P[u], P[v]), color="#9e9e9e", lw=1.0, zorder=1)
            ax.add_patch(FancyArrowPatch(P[u], P[v], connectionstyle="arc3,rad=-0.28", arrowstyle="-|>", mutation_scale=6, lw=0.9, color=c,
                                         zorder=3, shrinkA=4, shrinkB=4))
    else:                                     # a closed walk of even length can go back and forth along the strongest connection
        P = [(0.0, 0.42), (0.85, 0.42), (1.18, 0.85), (1.18, 0.0)]
        ax.plot(*zip(P[0], P[1]), color="#9e9e9e", lw=3.0, solid_capstyle="round", zorder=1)
        for v in (2, 3):
            ax.plot(*zip(P[1], P[v]), color="#9e9e9e", lw=0.8, zorder=1)
        for u, v in ((0, 1), (1, 0)):
            ax.add_patch(FancyArrowPatch(P[u], P[v], connectionstyle="arc3,rad=-0.5", arrowstyle="-|>", mutation_scale=6, lw=0.9, color=c,
                                         zorder=3, shrinkA=4, shrinkB=4))
    for xy in P:
        node(ax, xy)

