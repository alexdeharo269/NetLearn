    fig.text(0.79, yc + 0.035, lab, fontsize=6.0, va="center")
    fig.text(0.79, yc, f"between {100 * g.top_inter.mean():.0f}%", fontsize=5.6, va="center", color=HOM)
    fig.text(0.79, yc - 0.033, f"within {100 * g.top_intra.mean():.0f}%", fontsize=5.6, va="center", color=INTRA)
