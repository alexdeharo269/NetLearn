# Only the paper code is tracked: notebooks, the C++ engine, the Python sources, the
# bibliography, and the README with its animated figures and the JavaScript that builds
# them. Everything else (data, caches, binaries, results, figures, older notebooks and
# scripts) stays local.
/*
!/.gitignore
!/CLAUDE.md
!/README.md
!/engine/
!/notebooks/
!/src/
!/note/
!/animation/
!/assets/

# engine: sources and build files only (no binaries, Eigen, caches or outputs)
/engine/*
!/engine/esn.hpp
!/engine/esn_*.cpp
!/engine/Makefile
!/engine/build.ps1
!/engine/README.md

# notebooks: the notebooks only
/notebooks/*
!/notebooks/*.ipynb

# src: Python modules only
/src/*
!/src/*.py

# note: bibliography only
/note/*
!/note/*.bib

# animation: JavaScript sources only
/animation/*
!/animation/*.js

# assets: the animated figures of the README only
/assets/*
!/assets/*.svg

.ipynb_checkpoints/
__pycache__/
.DS_Store
