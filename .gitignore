# Only the paper code is tracked: notebooks, the C++ engine, the Python sources and the
# bibliography. Everything else (data, caches, binaries, results, figures, older notebooks
# and scripts) stays local.
/*
!/.gitignore
!/CLAUDE.md
!/engine/
!/notebooks/
!/src/
!/note/

# engine: sources and build files only (no binaries, Eigen, caches or outputs)
/engine/*
!/engine/esn.hpp
!/engine/esn_*.cpp
!/engine/Makefile
!/engine/build.ps1
!/engine/README.md

# notebooks: the notebooks only
/notebooks/*
!/notebooks/*.ipynb

# src: Python modules only
/src/*
!/src/*.py

# note: bibliography only
/note/*
!/note/*.bib

.ipynb_checkpoints/
__pycache__/
.DS_Store
